# PORT: The port the server listens on (automatically provided by Railway)
PORT=3000

# GEMINI_API_KEY: Optional. If provided, enables Gemini AI features.
# If omitted, the app automatically falls back to the built-in offline expert Deep Learning generator.
GEMINI_API_KEY=""

# NODE_ENV: Set to 'production' in production deployments
NODE_ENV="production"

# APP_URL: The URL where this applet is hosted.
APP_URL=""
